#version 450

#extension GL_EXT_control_flow_attributes : require

// SenseNova mHC router in one pass, one workgroup per token:
//
//   logits[r] = dot(w[r], x) / sqrt(mean(x*x) + eps) + b[r]   (same as mul_mat(w, rms_norm(x)) + b)
//
// then the route of mhc_route.comp: [sigmoid(pre), post_scale*sigmoid(post), comb]

layout(constant_id = 0) const uint BLOCK_SIZE = 256;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter
{
    uint K;
    uint n_iter;
    uint vec4_ok;

    uint nbx1;
    uint nbw1;
    uint nbd0; uint nbd1;

    uint x_offset;
    uint w_offset;
    uint b_offset;
    uint d_offset;

    float eps;
    float post_scale;
};

layout(binding = 0, std430) readonly buffer X   { float data_x[]; };
layout(binding = 0, std430) readonly buffer XV4 { vec4  data_x_v4[]; };
layout(binding = 1, std430) readonly buffer W   { float data_w[]; };
layout(binding = 1, std430) readonly buffer WV4 { vec4  data_w_v4[]; };
layout(binding = 2, std430) readonly buffer B   { float data_b[]; };
layout(binding = 3, std430) writeonly buffer D  { float data_d[]; };

shared float red[9][BLOCK_SIZE];

float softplus(float x) {
    return (x > 20.0f) ? x : log(1.0f + exp(x));
}

float sigmoid(float x) {
    return 1.0f / (1.0f + exp(-x));
}

// -softplus(d) == -softplus(-d) - d, so one softplus per pair
void normalize_pair(inout float x, inout float y) {
    const float delta = x - y;
    x = -softplus(-delta);
    y = x - delta;
}

void main() {
    const uint it  = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationID.x;

    // acc[0..7]: dot products, acc[8]: sum of squares
    float acc[9];
    [[unroll]] for (uint r = 0; r < 9; ++r) {
        acc[r] = 0.0f;
    }

    const uint xb = x_offset + it * nbx1;
    if (vec4_ok != 0) {
        for (uint i = tid; i < K / 4; i += BLOCK_SIZE) {
            const vec4 xv = data_x_v4[xb / 4 + i];
            acc[8] += dot(xv, xv);
            [[unroll]] for (uint r = 0; r < 8; ++r) {
                acc[r] += dot(data_w_v4[(w_offset + r * nbw1) / 4 + i], xv);
            }
        }
    } else {
        for (uint i = tid; i < K; i += BLOCK_SIZE) {
            const float xv = data_x[xb + i];
            acc[8] = fma(xv, xv, acc[8]);
            [[unroll]] for (uint r = 0; r < 8; ++r) {
                acc[r] = fma(data_w[w_offset + r * nbw1 + i], xv, acc[r]);
            }
        }
    }

    [[unroll]] for (uint r = 0; r < 9; ++r) {
        red[r][tid] = acc[r];
    }
    barrier();
    [[unroll]] for (uint s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
        if (tid < s) {
            [[unroll]] for (uint r = 0; r < 9; ++r) {
                red[r][tid] += red[r][tid + s];
            }
        }
        barrier();
    }

    if (tid != 0) {
        return;
    }

    const float scale = inversesqrt(red[8][0] / float(K) + eps);
    float l[8];
    [[unroll]] for (uint r = 0; r < 8; ++r) {
        l[r] = fma(red[r][0], scale, data_b[b_offset + r]);
    }

    float m00 = l[4];
    float m01 = l[5];
    float m10 = l[6];
    float m11 = l[7];
    for (uint i = 0; i < n_iter; ++i) {
        normalize_pair(m00, m01);
        normalize_pair(m10, m11);
        normalize_pair(m00, m10);
        normalize_pair(m01, m11);
    }

    const uint db = d_offset + it * nbd1;
    data_d[db + 0 * nbd0] = sigmoid(l[0]);
    data_d[db + 1 * nbd0] = sigmoid(l[1]);
    data_d[db + 2 * nbd0] = sigmoid(l[2]) * post_scale;
    data_d[db + 3 * nbd0] = sigmoid(l[3]) * post_scale;
    data_d[db + 4 * nbd0] = exp(m00);
    data_d[db + 5 * nbd0] = exp(m10);
    data_d[db + 6 * nbd0] = exp(m01);
    data_d[db + 7 * nbd0] = exp(m11);
}
